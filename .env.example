# UOA Detector — credentials template.
#
# Copy this file to ``.env`` at the repo root, then fill in the values.
# ``.env`` is .gitignore'd; this file (.env.example) is committed so
# contributors know which environment variables exist.
#
# DO NOT commit your filled-in ``.env``. The pre-commit hook
# (scripts/check_no_secrets.sh) catches accidental commits of
# credential-looking strings.

# ---- ThetaData Pro plan ----------------------------------------------------
# Get from https://www.thetadata.net/ → account → API tab.
# Both fields are required to use the ThetaData adapter (Phase 3.3.2+).
THETADATA_API_KEY=
THETADATA_USERNAME=

# ---- Unusual Whales (full API) ---------------------------------------------
# Get from https://unusualwhales.com/account → API tab.
# Required for the UnusualWhalesLiveSource and the six derived providers
# (Phase 3.3.3+).
UNUSUAL_WHALES_API_KEY=

# ---- Web app + live worker (Phase 5.0) -------------------------------------
# Database the webapp reads and the live worker writes (unset: sqlite:///webapp/seed.db).
DATABASE_URL=
# Comma-separated live-worker tickers; unset means no live worker and no gamma refresh.
LIVE_TICKERS=
# HTTP Basic auth user for every route except /health; unset or empty returns 503.
WEB_AUTH_USER=
# HTTP Basic auth password; set it in Railway variables, never in this file.
WEB_AUTH_PASSWORD=
