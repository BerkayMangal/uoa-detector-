  "shared_parameter_reference": {
    "format": {
      "description": "The format of the data when returned to the user.",
      "schema": {
        "type": "string",
        "enum": [
          "csv",
          "json",
          "ndjson",
          "html"
        ],
        "default": "csv"
      }
    },
    "request_type": {
      "description": "The request type.",
      "schema": {
        "type": "string",
        "enum": [
          "trade",
          "quote"
        ]
      }
    },
    "symbol": {
      "description": "The stock or index symbol, or underlying symbol for options.",
      "schema": {
        "type": "string"
      }
    },
    "expiration": {
      "description": "The expiration of the contract in `YYYY-MM-DD` or `YYYYMMDD` format.",
      "schema": {
        "type": "string",
        "format": "date"
      }
    },
    "strike": {
      "description": "The strike price of the contract in dollars (ie `100.00` for `$100.00`), or `*` for all strikes.",
      "schema": {
        "type": "string",
        "default": "*"
      }
    },
    "right": {
      "description": "The right (call or put) of the contract.",
      "schema": {
        "type": "string",
        "enum": [
          "call",
          "put",
          "both"
        ],
        "default": "both"
      }
    },
    "date": {
      "description": "The date to fetch data for.",
      "schema": {
        "type": "string",
        "format": "date"
      }
    },
    "max_dte": {
      "description": "If specified, only contracts with a full calendar day 'Days to Expiration' (DTE) less than or equal to this number will be returned.",
      "schema": {
        "minimum": 0,
        "type": "integer",
        "format": "int32"
      }
    },
    "strike_range": {
      "description": "Used to specify a filter to limit the number of contracts returned relative to the underlying's spot price. Will return the specified number of strikes above and below the spot price, as well as the at-the-money strike.",
      "schema": {
        "minimum": 1,
        "type": "integer",
        "format": "int32"
      }
    },
    "min_time": {
      "description": "Filters snapshots to include only data with a timestamp greater or equal to the specified value (HH:mm:ss.SSS format).",
      "schema": {
        "type": "string",
        "format": "time"
      }
    },
    "annual_dividend": {
      "description": "The annualized expected dividend amount to be used in Greeks calculations.",
      "schema": {
        "type": "number",
        "format": "float"
      }
    },
    "rate_type": {
      "description": "The interest rate type to be used in a Greeks calculation.",
      "schema": {
        "type": "string",
        "enum": [
          "sofr",
          "treasury_m1",
          "treasury_m3",
          "treasury_m6",
          "treasury_y1",
          "treasury_y2",
          "treasury_y3",
          "treasury_y5",
          "treasury_y7",
          "treasury_y10",
          "treasury_y20",
          "treasury_y30"
        ],
        "default": "sofr"
      }
    },
    "rate_value": {
      "description": "The interest rate, as a percent, to be used in a Greeks calculation.",
      "schema": {
        "type": "number",
        "format": "float"
      }
    },
    "stock_price": {
      "description": "The underlying stock price to be used in the Greeks calculation.",
      "schema": {
        "type": "number",
        "format": "float"
      }
    },
    "version": {
      "description": "Used to adjust Greeks calculation methodology. \"1\" uses a fixed .15 DTE for 0DTE; \"latest\" uses real TTE (down to a minimum of 1 hour)",
      "schema": {
        "type": "string",
        "enum": [
          "latest",
          "1"
        ],
        "default": "latest"
      }
    },
    "start_date": {
      "description": "The start date (inclusive).",
      "schema": {
        "type": "string",
        "format": "date"
      }
    },
    "end_date": {
      "description": "The end date (inclusive).",
      "schema": {
        "type": "string",
        "format": "date"
      }
    },
    "interval": {
      "description": "The size of the time interval must be one of the available options listed below. Intervals less than 1m are available only for single-day requests.",
      "schema": {
        "type": "string",
        "enum": [
          "tick",
          "10ms",
          "100ms",
          "500ms",
          "1s",
          "5s",
          "10s",
          "15s",
          "30s",
          "1m",
          "5m",
          "10m",
          "15m",
          "30m",
          "1h"
        ],
        "default": "1s"
      }
    },
    "start_time": {
      "description": "The start time (inclusive) in the specified day.",
      "schema": {
        "type": "string",
        "format": "time",
        "default": "09:30:00"
      }
    },
    "end_time": {
      "description": "The end time (inclusive) in the specified day.",
      "schema": {
        "type": "string",
        "format": "time",
        "default": "16:00:00"
      }
    },
    "exclusive": {
      "description": "If you prefer to match quotes with timestamps that are < the trade timestamp.",
      "schema": {
        "type": "boolean",
        "default": true
      }
    },
    "underlyer_use_nbbo": {
      "description": "Used to select underlyer pricing for Greeks calculation. \"true\" uses the midpoint of the NBBO; \"false\" uses the last trade price.",
      "schema": {
        "type": "boolean",
        "default": true
      }
    },
    "time_of_day": {
      "description": "The time of the day to fetch data for; assumed to be America/New_York.",
      "schema": {
        "type": "string",
        "format": "time"
      }
    }
  },
  "safe_probe": {
    "script": "/workspace/work/probe_theta_capabilities.py",
    "default": "DRY_RUN_NO_NETWORK",
    "maximum_requests": 10,
    "exact_contract_window_seconds": 10,
    "max_window_seconds": 30,
    "max_response_bytes_per_request": 4194304,
    "retries": 0,
    "credentials": "Provider login handled only byTerminal;script reads onlyTHETADATA_BASE_URL",
    "blocked_statuses": [
      "AUTH_REQUIRED",
      "ACCESS_DENIED",
      "NO_DATA",
      "RATE_LIMITED",
      "REQUEST_OR_ENDPOINT_UNSUPPORTED",
      "TRANSPORT_ERROR"
    ],
    "no_actual_calls_performed": true
  },
  "cost_effective_acquisition_order": [
    "Verify exact-contract capabilities with10smallreads.",
    "Resolve8frozen candidate entry/exit windows,cache once by immutable query.",
    "Collect prospective selected-contract quote windows and original signal evidence daily.",
    "Use interval1s/1m for exploratory surfaces, tick only for execution or ambiguous windows.",
    "Expand chosen symbols/dates/expiries only after measuring sample coverage,requestlimits,storage and research power.",
    "Avoid all-market wildcard tick histories,duplicate refreshes,unbounded retries,and repeatedly mining already rejected panels."
  ],
  "plan_boundaries": [
    "OptionsProfessional does not prove stock/index/SIP data rights.",
    "Underlying prices embedded in Greeks are model inputs with timestamps,not independent licensedstockquote series.",
    "No contract deliverable/multiplier adjustment endpoint verified.",
    "Terms,quotas,andconcurrency must be observed from liveTerminal/providerdocumentation before sustained collection.",
    "Data use increases evidence;it does not guarantee a profitable strategy."
  ]
